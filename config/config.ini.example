###################################################################################################
# Dynamic Technology Tree 配置文件 / Configuration File
# 修改后保存并运行（CTRL + S） generate_tech_tree.exe 以生成最新输出。
#
# Quick Start (English):
# 1. Set the base paths under [paths]. The bundled ones are examples from the author's machine—replace with yours.
# 2. Pick the target language via [localization] -> language (only that language will be generated).
# 3. (Optional) Tune priority_mods to control localization override priority (higher priority mods listed first).
# 4. (Optional) Adjust visualization scale parameters under [display].
# 5. Save and run generate_tech_tree.exe to build fresh output.
###################################################################################################

[paths]
# 群星本体安装目录 | Absolute path to the Stellaris base game installation directory.
base_game_path = D:\SteamLibrary\steamapps\common\Stellaris

# Steam创意工坊目录（281990是群星的AppID）| Root Steam Workshop folder for Stellaris (AppID 281990) containing subscribed mod subfolders
mod_folder_path = D:\SteamLibrary\steamapps\workshop\content\281990

# 自定义 dlc_load.json 路径（这个是识别mod用的文件，非Windows用户记得调整目录） | Optional explicit path to dlc_load.json (used to detect enabled mods)
# 留空将默认使用: %USERPROFILE%\Documents\Paradox Interactive\Stellaris\dlc_load.json | Leave empty to auto-resolve to the default location.
dlc_load_path = 

# (可选) 本地MOD目录 (本地mod放在此路径) | Optional local (user) mod root containing your .mod descriptor files
# 留空将默认使用: %USERPROFILE%\Documents\Paradox Interactive\Stellaris\mod | Leave empty to use the default user mods directory.
local_mod_folder_path = 

[localization]
# 目标语言（仅输出这一种）| Target language (only this language's localization files will be produced)
# 可选值 | Allowed values (case-insensitive): english, simp_chinese, french, german, spanish, russian, korean, japanese, polish, braz_por
language = simp_chinese
# 覆盖优先级 (高优先级在前, 逗号分隔多个) | Comma-separated mod IDs whose localization should override others first (highest priority first)
priority_mods = 2131014154

[display]
#################################################################
# max_children_per_node (Y)
#  用途: 限制“非根节点”可展开的直接子科技数量; 0 表示不限制。
#  English: Maximum number of direct child technologies shown for any NON-root node. 0 = unlimited.
#  Increase: shows more complete branching. Decrease: more compact output. Typical range: 6–20.
max_children_per_node = 12

#################################################################
# max_tree_depth (X)
#  用途: 限制从根出发的层级深度，超过深度不再递归，0 表示不限制。
#  English: Maximum traversal depth from each root. Nodes deeper than this are not expanded. 0 = unlimited.
#  Recommendation: 3–6. Very large values with large mod sets can produce extremely long in-game tooltip strings.
max_tree_depth = 4

#################################################################
# max_display_nodes (T)
#  用途: 全局唯一科技节点显示上限; 0 = 不限制。
#  English: Global cap on the total number of distinct technology nodes rendered. 0 = unlimited.
#  Two-phase logic:
#    (1) Pre-check: If any root has more direct children than T, even (X=1, Y=∞) cannot fit them => emit "too many root children" notice immediately.
#    (2) Probe: Otherwise first attempt with raw (X_raw, Y_raw). If result fits within T, keep it; if it exceeds, search for the best reduced (x,y) pair and re-render.
#  Supplementary stats: If a technology's direct children count > T (when T>0), it is recorded in an 'overlong' list.
#  Risk: Large values can yield extremely long tooltip strings and may cause hover lag in-game.
#  Practical sweet spot: 64–256 depending on mod size.
max_display_nodes = 128
